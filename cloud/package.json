{
  "name": "booked-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787 --var API_TOKEN:dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply booked --local",
    "migrate:remote": "wrangler d1 migrations apply booked --remote",
    "build": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "wrangler": "^4.147.0"
  }
}
