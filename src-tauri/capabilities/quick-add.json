{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick-add",
  "description": "Capability for the quick-add window",
  "windows": ["quick-add"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    { "identifier": "core:window:allow-set-size", "platforms": ["windows"] },
    { "identifier": "core:window:allow-center", "platforms": ["windows"] },
    { "identifier": "core:window:allow-hide", "platforms": ["windows"] }
  ]
}
