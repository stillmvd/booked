{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Booked",
  "version": "../package.json",
  "identifier": "com.stillmvd.booked",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Booked",
        "width": 1100,
        "height": 720,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/images/*",
          "$APPLOCALDATA/previews/**/*",
          "$APPLOCALDATA/icons/*",
          "$APPLOCALDATA/avatars/*"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0RkQ5NDgxRjQyRURFQzMKUldURDNpNzBnWlQ5Vkc0WFo0Wjd4KzhWR1dtMCtadWFvREt0SE9hNENxUmwvV1ZKOHozdFFzSk8K",
      "endpoints": ["https://github.com/stillmvd/booked/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "template": "nsis/installer.nsi"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
